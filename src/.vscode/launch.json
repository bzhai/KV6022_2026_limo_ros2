    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: trajectory_publisher (route1 dis)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/trajectory_referee/trajectory_referee/trajectory_publisher.py",
            "args": ["route1", "dis"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}